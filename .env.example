# Copy this file to .env and update the values for your setup.
# Do not commit your real .env file.

# Pixoo device IP or hostname used by your pixoo-rest bridge setup.
HOST="pixoo64.local"

# Weather location for Open-Meteo.
LATITUDE="40.7128"
LONGITUDE="-74.0060"

# Open-Meteo timezone. Use "auto" or an IANA name like "America/New_York".
TIMEZONE="auto"

# Local preview/debug behavior.
PREVIEW="False"
DEBUG="False"

# Weather fetch interval in minutes.
FETCH_INTERVAL="5"

# Display refresh behavior.
DISPLAY_REFRESH_INTERVAL_SECONDS="60"
PIXOO_UPLOAD_MODE="image"
GIF_FRAME_DURATION_MS="60000"
ENABLE_BLINK_ANIMATION="False"

# Icon set selection.
PIXOO_ICON_SET="premium_pixel"

# Optional icon testing overrides. Leave blank for real weather.
PIXOO_TEST_CURRENT_WEATHER_CODE=""
PIXOO_TEST_CURRENT_IS_DAY=""
PIXOO_TEST_FORECAST_WEATHER_CODES=""
